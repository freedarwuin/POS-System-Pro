CREATE TABLE `facturas_proveedores` (
  `id` INT AUTO_INCREMENT PRIMARY KEY,
  `id_proveedor` INT NOT NULL,
  `numero_factura` VARCHAR(50) NOT NULL,
  `descripcion_mercancia` TEXT NOT NULL,
  `monto_total` DECIMAL(15,2) NOT NULL DEFAULT 0.00,
  `archivo_factura` VARCHAR(255) DEFAULT NULL,
  `fecha_factura` DATE NOT NULL,
  `fecha_registro` DATETIME NOT NULL,
  FOREIGN KEY (`id_proveedor`) REFERENCES `proveedores`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;




-- 1. Modificamos la tabla de facturas para llevar el control de los saldos
ALTER TABLE `facturas_proveedores` 
ADD COLUMN `saldo_pendiente` DECIMAL(15,2) NOT NULL DEFAULT 0.00 AFTER `monto_total`,
ADD COLUMN `estado` ENUM('Pendiente', 'Abonada', 'Pagada') NOT NULL DEFAULT 'Pendiente' AFTER `saldo_pendiente`;

-- 2. Creamos la tabla para almacenar los abonos individuales por factura
CREATE TABLE `abonos_proveedores` (
  `id` INT AUTO_INCREMENT PRIMARY KEY,
  `id_factura` INT NOT NULL,
  `monto_abono_usd` DECIMAL(15,2) NOT NULL DEFAULT 0.00,
  `monto_abono_bs` DECIMAL(15,2) NOT NULL DEFAULT 0.00,
  `tasa_cambio` DECIMAL(15,2) NOT NULL DEFAULT 1.00,
  `metodo_pago` VARCHAR(50) NOT NULL, -- Ej: Efectivo, Pago Móvil, Transferencia
  `nota` TEXT DEFAULT NULL,
  `fecha_abono` DATETIME NOT NULL,
  `usuario` VARCHAR(50) NOT NULL,
  FOREIGN KEY (`id_factura`) REFERENCES `facturas_proveedores`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

ALTER TABLE productos ADD COLUMN id_proveedor INT NULL;